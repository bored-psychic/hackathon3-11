# Free LLM provider: groq (default), openrouter or gemini.
LLM_PROVIDER=groq
# The key for the provider above. Groq: console.groq.com. OpenRouter: openrouter.ai/keys.
LLM_API_KEY=your_free_key_here
# Optional for groq, required for openrouter (use a ":free" id). List ids: python tests/list_models.py
LLM_MODEL=

# Only for LLM_PROVIDER=gemini, used when LLM_API_KEY or LLM_MODEL above is empty.
# GEMINI_API_KEY=your_key_from_aistudio.google.com
# GEMINI_MODEL=gemini-3.8-flash
