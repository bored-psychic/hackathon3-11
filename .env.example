# Free LLM provider: groq (default), openrouter or gemini.
LLM_PROVIDER=groq
# The key for groq or openrouter. Groq: console.groq.com. OpenRouter: openrouter.ai/keys.
LLM_API_KEY=your_free_key_here
# Optional for groq, required for openrouter (use a ":free" id). List ids: python tests/list_models.py
LLM_MODEL=

# Gemini never reads LLM_API_KEY. With this set, Gemini also answers when the provider above is rate-limited or down.
# GEMINI_API_KEY=your_key_from_aistudio.google.com
# Comma-separated, tried in order: free-tier quotas are per model.
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
